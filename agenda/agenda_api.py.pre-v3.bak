# ═══════════════════════════════════════════════════
# ESPECIALISTA-SEDE / ESPECIALISTA-SERVICIO
# ═══════════════════════════════════════════════════
@app.post("/api/v2/especialista-sedes")
def especialista_sede_add(req: EspecialistaSedeReq):
    conn = get_conn(); cur = conn.cursor()
    if req.activo is False:
        cur.execute("DELETE FROM especialista_sedes WHERE especialista_id=%s AND sede_id=%s", (req.especialista_id, req.sede_id))
    else:
        cur.execute("INSERT INTO especialista_sedes(especialista_id,sede_id) VALUES(%s,%s) ON CONFLICT DO NOTHING",
            (req.especialista_id, req.sede_id))
    return {"ok": True}

@app.post("/api/v2/especialista-servicios")
def especialista_servicio_add(req: EspecialistaServicioReq):
    conn = get_conn(); cur = conn.cursor()
    cur.execute("INSERT INTO especialista_servicios(especialista_id,servicio_id) VALUES(%s,%s) ON CONFLICT DO NOTHING",
        (req.especialista_id, req.servicio_id))
    return {"ok": True}

@app.delete("/api/v2/especialista-servicios/{especialista_id}/{servicio_id}")
def especialista_servicio_del(especialista_id: str, servicio_id: str):
    conn = get_conn(); cur = conn.cursor()
    cur.execute("DELETE FROM especialista_servicios WHERE especialista_id=%s AND servicio_id=%s",
        (especialista_id, servicio_id))
    return {"ok": True}

