"""
Agenda CJ Medical - API REST COMPLETA
Incluye CRUD de maestros + gestión de citas + clientes
"""
import os, json
from datetime import date, datetime
from typing import Optional, List
import psycopg2
import psycopg2.extras
from fastapi import FastAPI, HTTPException, Query
from pydantic import BaseModel

app = FastAPI(title="Agenda CJ Medical")
DATABASE_URL = os.environ.get("DATABASE_URL", "postgresql://postgres@127.0.0.1:5432/cjmedical")

def get_conn():
    conn = psycopg2.connect(DATABASE_URL)
    conn.autocommit = True
    return conn

# ═══════════════════════════════════════════════════
# MODELOS
# ═══════════════════════════════════════════════════
class ClienteCrear(BaseModel):
    documento: str; primer_nombre: str; primer_apellido: str
    telefono: str; correo: Optional[str] = None; sede: str

class ClienteEditar(BaseModel):
    documento: Optional[str] = None; primer_nombre: Optional[str] = None
    primer_apellido: Optional[str] = None; telefono: Optional[str] = None
    correo: Optional[str] = None; sede: Optional[str] = None

class BuscarCliente(BaseModel): telefono: str

class HuecosRequest(BaseModel):
    fecha: date; sede: str
    especialista: Optional[str] = None; servicio: str
    duracion: Optional[int] = None; paso: int = 15

class BuscarHuecosReq(BaseModel):
    desde: Optional[date] = None; dias: int = 14
    sede: str; servicio: str; limite: int = 40

class ApartarCupoReq(BaseModel):
    especialista: str; sede: str; fecha: date; inicio: str
    servicio: str; minutos: int = 5; referencia: str

class AgendarReq(BaseModel):
    cliente_id: str; especialista: str; sede: str; fecha: date
    inicio: str; servicio: str
    canal: str = "WhatsApp"; por: str = "pepe"
    notas: Optional[str] = None; reserva: Optional[str] = None

class CambiarEstadoReq(BaseModel):
    cita_id: str; estado: str; por: str = "pepe"
    motivo: Optional[str] = None

class ReprogramarReq(BaseModel):
    cita_id: str; fecha: date; inicio: str
    especialista: Optional[str] = None; sede: Optional[str] = None
    motivo: str = ""; por: str = "pepe"

class MoverCitaReq(BaseModel):
    fecha: Optional[date] = None; inicio: Optional[str] = None
    fin: Optional[str] = None; especialista_id: Optional[str] = None
    sede_id: Optional[str] = None; servicio_id: Optional[str] = None
    notas: Optional[str] = None

class EspecialistaReq(BaseModel):
    nombres: str; apellidos: str
    color: Optional[str] = "#8A7C75"; activo: bool = True

class EspecialistaEditReq(BaseModel):
    nombres: Optional[str] = None; apellidos: Optional[str] = None
    color: Optional[str] = None; activo: Optional[bool] = None

class EspecialistaSedeReq(BaseModel):
    especialista_id: str; sede_id: str; activo: Optional[bool] = None

class EspecialistaServicioReq(BaseModel):
    especialista_id: str; servicio_id: str

class HorarioReq(BaseModel):
    especialista_id: str; dia: int; sede_id: str
    desde: str; hasta: str
    alm_desde: Optional[str] = None; alm_hasta: Optional[str] = None

class ServicioReq(BaseModel):
    nombre: str; duracion: int; activo: bool = True

class ServicioEditReq(BaseModel):
    nombre: Optional[str] = None; duracion: Optional[int] = None; activo: Optional[bool] = None

class SedeReq(BaseModel):
    nombre: str; ciudad: Optional[str] = None
    direccion: Optional[str] = None; telefono: Optional[str] = None
    hora_inicio: str = "09:00"; hora_fin: str = "19:00"
    puestos: int = 1; activo: bool = True

class SedeEditReq(BaseModel):
    nombre: Optional[str] = None; ciudad: Optional[str] = None
    direccion: Optional[str] = None; telefono: Optional[str] = None
    hora_inicio: Optional[str] = None; hora_fin: Optional[str] = None
    puestos: Optional[int] = None; activo: Optional[bool] = None

class EstadoReq(BaseModel):
    nombre: str; color: str = "#8A7C75"
    tipo: str = "abierto"; inicial: bool = False
    orden: int = 50; activo: bool = True

class BloqueoReq(BaseModel):
    especialista: str; sede: str; fecha: date; inicio: str
    fin: str; motivo: str = "Bloqueo"; por: str = "admin"

# ═══════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════
from fastapi.middleware.cors import CORSMiddleware
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

# ═══════════════════════════════════════════════════
# HEALTH
# ═══════════════════════════════════════════════════
@app.get("/")
def root(): return {"agenda": "CJ Medical", "version": "2.0"}

@app.get("/health")
def health():
    try:
        conn = get_conn(); cur = conn.cursor(); cur.execute("SELECT 1")
        return {"status": "ok", "db": "conectada"}
    except Exception as e:
        return {"status": "error", "db": str(e)}

# ═══════════════════════════════════════════════════
# SEDES - CRUD
# ═══════════════════════════════════════════════════
@app.get("/sedes")
def sedes_list():
    conn = get_conn(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cur.execute("SELECT * FROM sedes ORDER BY nombre")
    return cur.fetchall()

@app.post("/api/v2/sedes")
def sedes_create(req: SedeReq):
    conn = get_conn(); cur = conn.cursor()
    sid = f"sede-cj-medical-{req.nombre.lower().replace(' ','-')[:40]}"
    cur.execute("INSERT INTO sedes(id,nombre,ciudad,hora_inicio,hora_fin,puestos,activo) VALUES(%s,%s,%s,%s,%s,%s,%s) ON CONFLICT(id) DO UPDATE SET nombre=%s,ciudad=%s,hora_inicio=%s,hora_fin=%s,puestos=%s,activo=%s",
        (sid, req.nombre, req.ciudad, req.hora_inicio, req.hora_fin, req.puestos, req.activo,
         req.nombre, req.ciudad, req.hora_inicio, req.hora_fin, req.puestos, req.activo))
    cur.execute("SELECT * FROM sedes WHERE id=%s", (sid,))
    return cur.fetchone()

@app.put("/api/v2/sedes/{sid}")
def sedes_update(sid: str, req: SedeEditReq):
    conn = get_conn(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    updates = {k: v for k, v in req.dict().items() if v is not None}
    if not updates: raise HTTPException(400, "Nada que actualizar")
    parts = ", ".join(f"{k}=%({k})s" for k in updates)
    updates["sid"] = sid
    cur.execute(f"UPDATE sedes SET {parts} WHERE id=%(sid)s", updates)
    cur.execute("SELECT * FROM sedes WHERE id=%s", (sid,))
    r = cur.fetchone()
    if not r: raise HTTPException(404, "Sede no encontrada")
    return r

@app.delete("/api/v2/sedes/{sid}")
def sedes_delete(sid: str):
    conn = get_conn(); cur = conn.cursor()
    cur.execute("DELETE FROM sedes WHERE id=%s", (sid,))
    return {"ok": True}

# ═══════════════════════════════════════════════════
# SERVICIOS - CRUD
# ═══════════════════════════════════════════════════
@app.get("/servicios")
def servicios_list():
    conn = get_conn(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cur.execute("SELECT * FROM servicios ORDER BY nombre")
    return cur.fetchall()

@app.post("/api/v2/servicios")
def servicios_create(req: ServicioReq):
    conn = get_conn(); cur = conn.cursor()
    sid = f"srv-{req.nombre.lower().replace(' ','-')[:50]}"
    cur.execute("INSERT INTO servicios(id,nombre,duracion,activo) VALUES(%s,%s,%s,%s) ON CONFLICT(id) DO UPDATE SET nombre=%s,duracion=%s,activo=%s",
        (sid, req.nombre, req.duracion, req.activo, req.nombre, req.duracion, req.activo))
    # Also add all specialists to this service
    cur.execute("SELECT id FROM especialistas WHERE activo")
    for (eid,) in cur.fetchall():
        try: cur.execute("INSERT INTO especialista_servicios(especialista_id,servicio_id) VALUES(%s,%s) ON CONFLICT DO NOTHING", (eid, sid))
        except: pass
    cur.execute("SELECT * FROM servicios WHERE id=%s", (sid,))
    return cur.fetchone()

@app.put("/api/v2/servicios/{sid}")
def servicios_update(sid: str, req: ServicioEditReq):
    conn = get_conn(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    updates = {k: v for k, v in req.dict().items() if v is not None}
    if not updates: raise HTTPException(400, "Nada que actualizar")
    parts = ", ".join(f"{k}=%({k})s" for k in updates)
    updates["sid"] = sid
    cur.execute(f"UPDATE servicios SET {parts} WHERE id=%(sid)s", updates)
    cur.execute("SELECT * FROM servicios WHERE id=%s", (sid,))
    r = cur.fetchone()
    if not r: raise HTTPException(404, "Servicio no encontrado")
    return r

@app.delete("/api/v2/servicios/{sid}")
def servicios_delete(sid: str):
    conn = get_conn(); cur = conn.cursor()
    cur.execute("DELETE FROM servicios WHERE id=%s", (sid,))
    return {"ok": True}

# ═══════════════════════════════════════════════════
# ESPECIALISTAS - CRUD
# ═══════════════════════════════════════════════════
@app.get("/especialistas")
def especialistas_list():
    conn = get_conn(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cur.execute("SELECT e.*, COALESCE(array_agg(DISTINCT es.sede_id) FILTER (WHERE es.sede_id IS NOT NULL), '{}') as sedes FROM especialistas e LEFT JOIN especialista_sedes es ON es.especialista_id=e.id WHERE e.activo GROUP BY e.id ORDER BY e.nombres")
    return cur.fetchall()

@app.post("/api/v2/especialistas")
def especialistas_create(req: EspecialistaReq):
    conn = get_conn(); cur = conn.cursor()
    eid = f"esp-{req.nombres.lower().replace(' ','-')[:40]}-{req.apellidos.lower().replace(' ','-')[:20]}"
    cur.execute("INSERT INTO especialistas(id,nombres,apellidos,color,activo) VALUES(%s,%s,%s,%s,%s)",
        (eid, req.nombres, req.apellidos, req.color, req.activo))
    cur.execute("SELECT * FROM especialistas WHERE id=%s", (eid,))
    return cur.fetchone()

@app.put("/api/v2/especialistas/{eid}")
def especialistas_update(eid: str, req: EspecialistaEditReq):
    conn = get_conn(); cur = conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    updates = {k: v for k, v in req.dict().items() if v is not None}
    if not updates: raise HTTPException(400, "Nada que actualizar")
    parts = ", ".join(f"{k}=%({k})s" for k in updates)
    updates["eid"] = eid
    cur.execute(f"UPDATE especialistas SET {parts} WHERE id=%(eid)s", updates)
    cur.execute("SELECT * FROM especialistas WHERE id=%s", (eid,))
    r = cur.fetchone()
    if not r: raise HTTPException(404, "Especialista no encontrada")
    return r

@app.delete("/api/v2/especialistas/{eid}")
def especialistas_delete(eid: str):
    conn = get_conn(); cur = conn.cursor()
    cur.execute("SELECT count(*) FROM citas WHERE especialista_id=%s AND fecha>=CURRENT_DATE", (eid,))
    if cur.fetchone()[0] > 0:
        raise HTTPException(400, "La especialista tiene citas futuras. Reasígnalas primero.")
    cur.execute("UPDATE especialistas SET activo=false WHERE id=%s", (eid,))
    return {"ok": True, "mensaje": "Especialista desactivada"}

# ═══════════════════════════════════════════════════
# HORARIOS - CRUD
