@app.post("/api/v2/horarios")
def horarios_create(req: HorarioReq):
    conn = get_conn(); cur = conn.cursor()
    cur.execute("INSERT INTO horarios(especialista_id,dia,sede_id,desde,hasta,alm_desde,alm_hasta) VALUES(%s,%s,%s,%s,%s,%s,%s)",
        (req.especialista_id, req.dia, req.sede_id, req.desde, req.hasta, req.alm_desde, req.alm_hasta))
    return {"ok": True}

@app.delete("/api/v2/horarios/{hid}")
def horarios_delete(hid: int):
    conn = get_conn(); cur = conn.cursor()
