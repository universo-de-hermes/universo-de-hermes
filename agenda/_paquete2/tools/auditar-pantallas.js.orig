/* Recorre las 13 pantallas del panel y anota lo que de verdad hay en cada una:
   qué dice, qué botones tiene, si hay Atrás, si el texto se lee y si el botón
   principal es claro. No arregla nada — solo mide, para que el cliente decida.

     node auditar-pantallas.js            (necesita la agenda viva en :8001)
   Deja la tabla en /tmp/auditoria-pantallas.md y una foto por pantalla. */
const {chromium} = require('playwright');
const http = require('http'), fs = require('fs');
const PAGINA = '/var/www/html/autoservicio.html', PUERTO = 8977, API = 8001;
const DOC = '999000777', TEL = '3009998877';

const srv = http.createServer((q,r) => {
  if (q.url.startsWith('/api/')){
    const x = http.request({host:'127.0.0.1', port:API, path:q.url.slice(4),
      method:q.method, headers:q.headers}, y => { r.writeHead(y.statusCode,y.headers); y.pipe(r); });
    x.on('error', () => { r.writeHead(502); r.end('{}'); }); q.pipe(x); return;
  }
  fs.readFile(PAGINA,(e,b) => { r.writeHead(200,{'content-type':'text/html; charset=utf-8'}); r.end(b); });
});

function luz(c){
  const m = String(c).match(/[\d.]+/g); if (!m) return 0;
  const [r,g,b] = m.slice(0,3).map(Number);
  const f = v => { v/=255; return v<=.03928 ? v/12.92 : Math.pow((v+.055)/1.055,2.4); };
  return .2126*f(r)+.7152*f(g)+.0722*f(b);
}
const razon = (a,b) => { const [x,y]=[luz(a),luz(b)].sort((p,q)=>q-p); return (x+.05)/(y+.05); };

const MIRAR = () => {
  const q = s => document.querySelector(s);
  const fondo = el => { let n=el; while(n&&n!==document.documentElement){
    const cs=getComputedStyle(n);
    if(cs.backgroundImage&&cs.backgroundImage!=='none'){
      const c=cs.backgroundImage.match(/rgba?\([^)]+\)/); if(c) return c[0]; }
    const b=cs.backgroundColor, a=(b.match(/[\d.]+/g)||[])[3];
    if(b&&b!=='transparent'&&a!=='0') return b; n=n.parentElement; }
    return getComputedStyle(document.body).backgroundColor; };
  const pri = q('#vista .btn.pri') || q('#vista .btn');
  const textos = [];
  document.querySelectorAll('#vista h1, #vista .sub, #vista .aviso, #vista .pista-doc')
    .forEach(e => { const t=e.innerText.trim(); if(t) textos.push({clase:e.className||e.tagName, t}); });
  return {
    paso: typeof S !== 'undefined' ? S.paso : '?',
    titulo: (q('#vista h1')||{}).innerText || '',
    sub: (q('#vista .sub')||{}).innerText || '',
    aviso: (q('#vista .aviso')||{innerText:''}).innerText.trim(),
    botones: [...document.querySelectorAll('#vista button')]
      .filter(b => !b.closest('.teclas') && !b.closest('.cal .dias'))
      .map(b => b.innerText.trim().split('\n')[0]).filter(Boolean),
    teclado: !!q('#vista .teclas'),
    calendario: !!q('#vista .cal'),
    opciones: document.querySelectorAll('#vista .opcion').length,
    campos: document.querySelectorAll('#vista input, #vista select').length,
    atras: !q('#h-atras').hidden,
    priTexto: pri ? pri.innerText.trim() : null,
    priColor: pri ? getComputedStyle(pri).color : null,
    priFondo: pri ? fondo(pri) : null,
    priAlto: pri ? Math.round(pri.getBoundingClientRect().height) : 0,
    textos
  };
};

(async () => {
  await new Promise(r => srv.listen(PUERTO, r));
  const nav = await chromium.launch({executablePath:'/root/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome'});
  const ctx = await nav.newContext({viewport:{width:1024,height:768}, hasTouch:true});
  const p = await ctx.newPage();
  const vistas = [];
  const anotar = async (etq) => {
    await p.waitForTimeout(500);
    const m = await p.evaluate(MIRAR);
    m.etq = etq;
    m.contrastePri = (m.priColor && m.priFondo) ? razon(m.priColor, m.priFondo) : null;
    m.peorTexto = null;
    vistas.push(m);
    await p.screenshot({path:`/tmp/pant-${String(vistas.length).padStart(2,'0')}-${m.paso}.png`});
    console.log(`  ${String(vistas.length).padStart(2)}. ${m.paso.padEnd(22)} «${(m.titulo||'—').slice(0,40)}»`);
  };
  const toca = async s => p.locator('#vista button', {hasText:s}).first().click();
  const teclear = async n => { for (const d of String(n))
    await p.locator('.teclas button', {hasText:new RegExp('^'+d+'$')}).first().click(); };

  await p.goto(`http://localhost:${PUERTO}/autoservicio.html?sede=el-tesoro`);
  await p.waitForTimeout(1500);
  if (!(await p.evaluate(() => document.querySelector('#llave').hidden))){
    await p.fill('#l-correo','jhotas96@gmail.com');
    await p.fill('#l-clave','TzEi4LntP6I8TC');
    await p.click('#l-abrir'); await p.waitForTimeout(2500);
  }
  await p.waitForSelector('#bienvenida:not([hidden])', {timeout:15000});
  await p.click('#bienvenida');

  await anotar('la clienta llega');                      /* documento */
  await teclear('123');
  await anotar('con el documento a medias');             /* documento, con pista */
  await p.evaluate(() => { S.doc=''; pintar(); });
  await teclear(DOC); await toca('Continuar');
  await p.waitForTimeout(1800);
  await anotar('no la conocemos');                       /* nuevo */
  await toca('Guardar y continuar');
  await p.waitForTimeout(700);
  await anotar('guardó sin llenar nada');                /* nuevo con error */
  const campo = async (ph,v) => p.locator(`input[placeholder="${ph}"]`).first().fill(v);
  await campo('Escriba su nombre','Prueba'); await campo('Escriba su apellido','Auditoría');
  await campo('Escriba su celular',TEL); await campo('Escriba su correo','auditoria@cjmedical.co');
  await toca('Guardar y continuar'); await p.waitForTimeout(2500);
  await anotar('escoge el servicio');                    /* servicio */
  await p.locator('.opcion').first().click(); await p.waitForTimeout(800);
  await anotar('escoge el día');                         /* cuando */
  await toca('Otro día'); await p.waitForTimeout(800);
  await anotar('el calendario');                         /* calendario */
  let hay = false;
  for (let i=0;i<10 && !hay;i++){
    const libres = await p.$$('.cal .dias button:not([disabled])');
    if (!libres.length){ await p.locator('.cal .cab button').last().click();
                         await p.waitForTimeout(400); continue; }
    await libres[Math.min(i,libres.length-1)].click(); await p.waitForTimeout(1800);
    hay = (await p.$$('.hora')).length > 0;
    if (!hay && /no quedan horas/i.test(await p.evaluate(()=>document.body.innerText))){
      await toca('Ver otro día'); await p.waitForTimeout(600); }
  }
  await anotar('escoge la hora');                        /* horas */
  await p.locator('.hora').first().click(); await p.waitForTimeout(2000);
  await anotar('escoge con quién');                      /* especialista */
  await p.locator('.opcion').first().click(); await p.waitForTimeout(2000);
  await anotar('revisa antes de confirmar');             /* resumen */
  await toca('Confirmar cita'); await p.waitForTimeout(3000);
  await anotar('listo');                                 /* final */
  await p.locator('#h-salir').click(); await p.waitForTimeout(600);
  await p.click('#bienvenida'); await teclear(DOC); await toca('Continuar');
  await p.waitForTimeout(2000);
  await anotar('ya la conocemos');                       /* ficha o cita */
  if (/Usted ya tiene una cita/i.test(await p.evaluate(()=>document.body.innerText))){
    await toca('Reprogramar'); await p.waitForTimeout(700);
    await anotar('por su seguridad');                    /* verificar */
    await teclear(TEL); await toca('Continuar'); await p.waitForTimeout(1200);
    await anotar('mover la cita');                       /* reprogramar_servicio */
    await p.locator('#h-salir').click(); await p.waitForTimeout(500);
    await p.click('#bienvenida'); await teclear(DOC); await toca('Continuar');
    await p.waitForTimeout(2000);
    await toca('Cancelar la cita'); await p.waitForTimeout(700);
    await teclear(TEL); await toca('Continuar'); await p.waitForTimeout(900);
    await anotar('va a cancelar');                       /* confirmar_cancelar */
  }

  const L = [];
  L.push('| # | Pantalla | Qué dice | Botones | Atrás | Avisa | Botón principal |');
  L.push('|---|---|---|---|---|---|---|');
  vistas.forEach((v,i) => {
    const dice = [v.titulo, v.sub].filter(Boolean).join(' / ').replace(/\n/g,' ').slice(0,74);
    const bot = v.botones.join(', ').slice(0,46)
      + (v.teclado?' +teclado':'') + (v.calendario?' +calendario':'')
      + (v.opciones?` +${v.opciones} fichas`:'') + (v.campos?` +${v.campos} campos`:'');
    const pri = v.priTexto
      ? `«${v.priTexto}» ${v.contrastePri?v.contrastePri.toFixed(1)+':1':'?'} ${v.priAlto}px`
      : '—';
    L.push(`| ${i+1} | \`${v.paso}\`<br>${v.etq} | ${dice} | ${bot} | ${v.atras?'sí':'**no**'} | ${v.aviso?('«'+v.aviso.slice(0,40)+'»'):'—'} | ${pri} |`);
  });
  fs.writeFileSync('/tmp/auditoria-pantallas.md', L.join('\n')+'\n');
  fs.writeFileSync('/tmp/auditoria-pantallas.json', JSON.stringify(vistas,null,1));
  console.log(`\n  ${vistas.length} pantallas recorridas → /tmp/auditoria-pantallas.md`);
  await nav.close(); srv.close();
})();
